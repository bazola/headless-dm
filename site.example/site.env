# site.env — where this realm lives. Copy to site/site.env and edit (plan 23 W1).
#
# Shell-style KEY=value: `ops/env.sh` sources this file, and services/common/site.py parses the same one,
# so there is a single set of answers rather than one per language. No secrets belong here — they go in
# site/secrets.env, mode 600. Everything under site/ is git-ignored.
#
# A key left unset falls back to the live server config where one exists, so a half-filled file still runs.

# --- paths ------------------------------------------------------------------
WOW_ROOT=/opt/wow
SERVER_PREFIX=/opt/wow/server
CORE_DIR=/opt/wow/azerothcore-wotlk
DATA_DIR=/opt/wow/server/data
BACKUP_DIR=/opt/wow/backups
LOGS_DIR=/opt/wow/logs
# The account the servers run as (systemd User=/Group=).
WOW_USER=wow
# Your own 3.3.5a build 12340 enUS client. Never copied into git.
# QUOTE IT if the path has spaces -- client folders usually do ("World of Warcraft 3.3.5a"). This file is
# sourced by the shell as well as parsed by Python, and an unquoted space makes the shell run the second
# word as a command.
CLIENT_DIR="/opt/wow/client"

# --- databases --------------------------------------------------------------
# The password is DB_PASS in secrets.env, never here.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=acore
DB_AUTH=acore_auth
DB_WORLD=acore_world
DB_CHARACTERS=acore_characters
DB_PLAYERBOTS=acore_playerbots

# --- the realm --------------------------------------------------------------
REALM_NAME=AzerothCore
# The address players type into realmlist.wtf; reachable from the machines that play.
REALM_ADDRESS=127.0.0.1
REALM_PORT=8085
# The world's clock. Nothing later than this era has happened. See Appendix C.
ERA=classic
# The realm's first day, for the chronicle's "day N" titles. YYYY-MM-DD.
REALM_FIRST_DAY=2026-01-01

# --- the GM console ---------------------------------------------------------
# RA_USER and RA_PASS are in secrets.env.
RA_HOST=127.0.0.1
RA_PORT=3443

# --- the dashboard ----------------------------------------------------------
# Bind to localhost, or to a private address. There is no per-user login: anyone who can reach it reads
# every household's lore, chronicle and journey. See GUIDE Part 0 rule 9.
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8787
DASHBOARD_URL=http://127.0.0.1:8787

# --- the lore gate ----------------------------------------------------------
# Its token is LORE_GATE_TOKEN in secrets.env.
LORE_GATE_BIND=127.0.0.1
LORE_GATE_PORT=8788
LORE_GATE_ORIGIN=http://127.0.0.1:8787
# Accounts whose characters are never offered a main: service accounts, not people.
LORE_GATE_SKIP_ACCOUNTS=MERCHANTS

# --- what the conf placeholders resolve against (plan 23 W5) ----------------
# conf/*.overrides records these as ${NAME}; ops/scripts/conf-apply.py fills them in and refuses to write
# a config with any placeholder it could not resolve.
SERVER_LOGS=/opt/wow/server/logs
# One per two cores is a sane start; Phase 1 measures the machine and recommends a number.
MAP_THREADS=4
# How many chat generations may be in flight at once. More than the fleet can serve only adds latency.
CHAT_CONCURRENCY=8
# Where the module sends its generations: the router, not a model server directly.
ROUTER_URL=http://127.0.0.1:11434/api/generate

# --- the auction house (plan 23 W17) ----------------------------------------
# The account and characters that hold the merchants' stock. Empty disables the seller.
MERCHANT_ACCOUNT=MERCHANTS
# One entry per merchant, comma-separated: Name:race:class:gender
#   race   2=Orc 1=Human 3=Dwarf 4=NightElf 5=Forsaken 6=Tauren 7=Gnome 8=Troll
#   class  1=Warrior is fine for all of them; they are never played
#   gender 0=male 1=female
# The race decides the house: Alliance races sell in the Alliance house, Horde races in the
# Horde house, and anyone may sell in the neutral houses. Empty disables the seller.
# Example (the reference realm's ten):
#   Merrick:1:1:0,Wilhelmina:1:1:1,Brunhild:3:1:1,Tobble:7:1:0,Sylvaine:4:1:1,
#   Grukash:2:1:0,Rakasha:2:1:1,Zanjira:8:1:1,Mortimer:5:1:0,Hakoda:6:1:0
MERCHANT_CHARACTERS=

# --- sizing -----------------------------------------------------------------
# Written by ops/scripts/add-bots.sh as the bot count grows.
BOT_MIN=100
BOT_MAX=120
# How many guilds the bots found on their own; these become the companies. Set it to 0 once they have
# formed (GUIDE 10.1) and restart: stories and seats assume the rosters stop moving before lore is
# written, and a guild bot re-rolled afterwards loses its tabard.
BOT_GUILDS=20
