# secrets.env — copy to site/secrets.env, `chmod 600`, and fill in (plan 23 W1, gate G4).
#
# This is the ONLY file secrets belong in. Never print one, never write one into a conf that is tracked,
# never put one on a command line that shows up in a process list. `ops/env.sh` sources this file and the
# `db` and `ra` helpers read it from the environment, which is why no password is ever typed into a query.
#
# Everything under site/ is git-ignored. Keep a copy in a password manager: the realm cannot be restored
# from backups without these.

# The MySQL account the server and the services use. The agent generates this during setup.
DB_PASS=

# The GM console account (RA, 127.0.0.1:3443). The operator chooses these at gate G4 and creates the
# account at the first boot (gate G6), at level 3.
RA_USER=
RA_PASS=

# mod-dashboard's command token: what lets the dashboard pause and resume the world. Agent-generated,
# at least 16 characters.
DASHBOARD_TOKEN=

# The lore gate's token. Every request to it carries this as X-Lore-Token; without it the gate stays shut.
# Anyone holding it can write lore for any household on the realm.
LORE_GATE_TOKEN=

# Optional: a remote model API, if this realm falls back to one for any lane (gate G5).
OPENROUTER_API_KEY=
