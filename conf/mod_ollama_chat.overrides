OllamaChat.Snapshot.IncludeSpells = 1
OllamaChat.Snapshot.TheirTasks = 0
OllamaChat.Roleplay.Enable = 1
OllamaChat.Roleplay.Strictness = 2
OllamaChat.Roleplay.MetaTermList = "dps|hps|nerf|nerfed|buffed|proc|procs|server|realm|respec|mmo|npc|npcs|toon|irl|lfg|lfd|afk|brb|noob|n00b|meta|aggro|aoe|hitbox|hotfix|expansion|xp|exp|ding|grats|gratz|gz|lol|lmao|gg|pvp|pve|pug|pugs|addon|addons|tank|tanks|healer|healers|spec|specs|ilvl|gearscore|dkp|respawn|mobs|lvl|leveling|level up|leveled up|logged in|logged off|log in|log off|online|offline|guildies|cooldown|cooldowns|crit|raid lockout|lockout|achievement|achievements|quest log|op"
OllamaChat.Chatter.UseLookingForGroupChannel = 1
OllamaChat.Chatter.UseGuildRecruitmentChannel = 1
