OllamaChat.Relationship.Enable = 0
OllamaChat.EnvCommentNearbyPlayer = You notice {player_name}, a {player_race} {player_class}, {player_state} nearby. Say something to or about them.|{player_name} the {player_class} is {player_state} close by. React to seeing them.|You size up {player_name}, a {player_race} {player_class}. Say what you make of them.|{player_name} is {player_state} within earshot. Greet or remark on them.
OllamaChat.EnvCommentGuildMemberOnline = Your companion {member_name} the {member_class} is about. Say something to the company about them.|Greet {member_name} in front of the company, or ask what they have been doing.|Mention {member_name} to the company and what you think of them.
OllamaChat.EnvCommentDanger = A {creature_name} nearby looks far stronger than you. Warn others or bluster.|The {creature_name} here looks deadly. Say whether you would dare face it.|Comment on the threat the {creature_name} poses.
